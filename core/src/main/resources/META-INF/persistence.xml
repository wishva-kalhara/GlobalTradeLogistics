<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="globalTradeLogisticsPU" transaction-type="JTA">
        <!-- Hibernate instead of GlassFish 7's bundled EclipseLink. -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>jdbc/globalTradeLogisticsDS</jta-data-source>
        <class>me.wishva.globalTradeLogistics.core.model.User</class>
        <class>me.wishva.globalTradeLogistics.core.model.Customer</class>
        <class>me.wishva.globalTradeLogistics.core.model.Supplier</class>
        <class>me.wishva.globalTradeLogistics.core.model.OtpCode</class>
        <class>me.wishva.globalTradeLogistics.core.model.Country</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <!--
                The 15 pre-existing SCM tables (schema.postgres.sql) are
                treated as a given legacy schema, seeded once via SQL and
                never touched by Hibernate. Everything WE added on top of it
                (users, otp_codes, the email-uniqueness constraints) is
                schema-owned by these entities instead — "update" creates
                missing tables/columns/constraints on startup, no hand-written
                migration SQL for our own additive pieces.
            -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- GlassFish is a fork of the old Sun Java System Application
                 Server lineage; Hibernate's SunOneJtaPlatform targets that
                 same JTA/TransactionManager JNDI lookup and works unchanged
                 on GlassFish/Payara. -->
            <property name="hibernate.transaction.jta.platform"
                      value="org.hibernate.engine.transaction.jta.platform.internal.SunOneJtaPlatform"/>
        </properties>
    </persistence-unit>
</persistence>
