<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.wishva.globalTradeLogistics</groupId>
        <artifactId>GlobalTradeLogistics</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>global-trade-logistics-ear</artifactId>
    <packaging>ear</packaging>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>me.wishva.globalTradeLogistics</groupId>
            <artifactId>global-trade-logistics-core</artifactId>
            <version>1.0.0</version>
            <type>jar</type>
        </dependency>
        <dependency>
            <groupId>me.wishva.globalTradeLogistics</groupId>
            <artifactId>global-trade-logistics-api-gateway</artifactId>
            <version>1.0.0</version>
            <type>war</type>
        </dependency>
        <dependency>
            <groupId>me.wishva.globalTradeLogistics</groupId>
            <artifactId>global-trade-logistics-iam-svc</artifactId>
            <version>1.0.0</version>
            <type>ejb</type>
        </dependency>
    </dependencies>

    <build>
        <finalName>glolabl-trade-logistics</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-ear-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <version>10</version>
                    <defaultLibBundleDir>lib</defaultLibBundleDir>
                    <modules>
                        <jarModule>
                            <!--
                                bundleDir intentionally omitted so this falls
                                back to defaultLibBundleDir (lib/) — a jar's
                                META-INF/persistence.xml (core's, here) is
                                only automatically visible EAR-wide by plain
                                unitName when it lives in the EAR's library
                                directory, per the Java EE deployment spec.
                                Bundling it at the EAR root instead ("/")
                                breaks unitName resolution for every other
                                module's @PersistenceContext.
                            -->
                            <groupId>me.wishva.globalTradeLogistics</groupId>
                            <artifactId>global-trade-logistics-core</artifactId>
                        </jarModule>
                        <webModule>
                            <groupId>me.wishva.globalTradeLogistics</groupId>
                            <artifactId>global-trade-logistics-api-gateway</artifactId>
                            <contextRoot>global-trade-logistics/api</contextRoot>
                        </webModule>
                        <ejbModule>
                            <groupId>me.wishva.globalTradeLogistics</groupId>
                            <artifactId>global-trade-logistics-iam-svc</artifactId>
                        </ejbModule>
                    </modules>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>