<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>me.wishva.globalTradeLogistics</groupId>
    <artifactId>GlobalTradeLogistics</artifactId>
    <version>1.0.0</version>
    <name>GlobalTradeLogistics</name>
    <packaging>pom</packaging>

    <modules>
        <module>app</module>
        <module>api-gateway</module>
        <module>core</module>
        <module>iam-svc</module>
        <module>order-svc</module>
        <module>inventory-svc</module>
        <module>procurement-svc</module>
        <module>logistics-svc</module>
        <module>monitoring-svc</module>
        <module>notification-svc</module>
        <module>frontend-customer</module>
        <module>frontend-seller</module>
        <module>frontend-app</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.target>11</maven.compiler.target>
        <maven.compiler.source>11</maven.compiler.source>
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.11.0</mockito.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>10.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Test-only: EJB service beans are plain POJOs when instantiated
                 directly (no container proxy), so their @PersistenceContext/@EJB
                 fields need a mock injected via reflection in tests — Mockito
                 mocks EntityManager/TypedQuery for that. -->
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Test-only: jakarta.jakartaee-api above is API-only (no
                 implementation) — GlassFish supplies the real Jakarta JSON
                 Processing impl at runtime, but a plain `mvn test` JVM has
                 none, so JwtService's Json.createObjectBuilder()/createReader()
                 calls fail with JsonException without this. Parsson is the
                 same JSON-P implementation GlassFish 7 bundles. -->
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
            <plugin>
                <!--
                    Pinned explicitly: the resolved-by-default 3.1 predates
                    Lombok/annotation-processor support on modern JDKs and
                    silently skips Lombok's code generation instead of
                    failing loudly.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>
</project>