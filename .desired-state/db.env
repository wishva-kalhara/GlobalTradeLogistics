# Desired state for the MySQL container and the app's JDBC connection.
# Consumed natively by the mysql image and by .build-new/entrypoint.sh.
MYSQL_DATABASE=global_trade_log_corp
MYSQL_USER=gtl_app
MYSQL_PASSWORD=gtl_app
# Required by the mysql image (no default/empty root password) — only ever
# used for the container's own root account, never by the app itself.
MYSQL_ROOT_PASSWORD=gtl_root
