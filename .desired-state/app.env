# Desired runtime state for the GlassFish app container.
# Consumed by .build-new/entrypoint.sh at container start.
DB_HOST=db
DB_PORT=5432
HTTP_PORT=8080
HTTPS_PORT=8181
ADMIN_PORT=4848
JNDI_NAME=jdbc/globalTradeLogisticsDS
POOL_NAME=globalTradeLogisticsPool

# JDBC connection pool sizing (see .build-new/entrypoint.sh's
# create-jdbc-connection-pool call). Kept small for a single-instance dev
# Postgres container — raise for real concurrent load.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=32
DB_POOL_MAX_WAIT_MS=10000

# HS256 signing secret for issued JWTs (JwtService). Dev-only value — for
# any real deployment, override via a local, gitignored env file.
JWT_SECRET=dev-only-change-me-globaltradelogistics-jwt-secret

# JMS resources for the notification topic (consumed by notification-svc,
# Phase 5) — created idempotently by entrypoint.sh. JNDI names follow the
# <service>.<resource>.<action> convention: notification-svc's email
# resource's send action.
NOTIFICATION_TOPIC_CF_JNDI=jms/notification.email.send.factory
NOTIFICATION_TOPIC_JNDI=jms/notification.email.send
